---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`about · ${SITE_TITLE}`} description={`about ${AUTHOR}`} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1>about</h1>
				<p>
					I'm HSG. I spend my time building agentic infrastructure, AI systems,
					observability and performance work, inference efficiency, product, and the
					teams that ship it all at speed. This is where I unload my brain: raw
					thoughts, letters to my younger self, lessons for my future self. No
					schedule, no theme. Just writing in public.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>