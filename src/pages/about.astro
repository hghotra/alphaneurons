---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={`About ${AUTHOR}`} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1>About</h1>
				<p>
					I'm HSG. This is a place to dump my raw thoughts — letters to my younger self,
					lessons for my future self, and whatever else needs unloading from my brain.
					No schedule, no theme. Just writing in public.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>